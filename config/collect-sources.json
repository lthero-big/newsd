      "url": "https://openai.com/news/rss.xml"
    },
    {
      "id": "google-ai-blog",
      "url": "https://blog.google/technology/ai/rss/"
    }
  ],
  "github_search": {
    "queries": [
      "topic:llm",
      "topic:ai-agents",
      "topic:generative-ai",
      "topic:diffusion",
      "topic:text-to-speech",
      "topic:mcp"
    ],
    "created_days": 14,
    "min_stars": 50,
    "per_query": 15
  },
  "hf_trending": {
    "limit": 20
  },
  "ossinsight": {
    "period": "past_24_hours",
    "language": "All",
    "limit": 25
  },
  "rsshub": {
    "_note": "自建 RSSHub（环境变量 RSSHUB_BASE + RSSHUB_ACCESS_KEY）；未配置时插件跳过。与 rss 里已有的源不重复（如 openai-news）。",
    "routes": [
      {
        "id": "rsshub-qbitai",
        "route": "/qbitai/category/资讯",
        "label": "量子位"
      },
      {
        "id": "rsshub-qbitai-llm",
        "route": "/qbitai/tag/大模型",
        "label": "量子位·大模型"
      },
      {
        "id": "rsshub-infoq-ai",
        "route": "/infoq/topic/AI",
        "label": "InfoQ AI"
      },
      {
        "id": "rsshub-anthropic",
        "route": "/anthropic/news",
        "label": "Anthropic News"
      },
      {
        "id": "rsshub-hf-papers",
        "route": "/huggingface/daily-papers",
        "label": "HF Daily Papers",
        "max": 8
      }
    ]
  },
  "x": {
    "_note": "X 只走自建 RSSHub（/twitter/user、/twitter/keyword），不再走 X 连接器；需要配置 RSSHUB_BASE 和 RSSHUB_ACCESS_KEY。",
    "suffix": "has:images -is:retweet -is:reply lang:en",
    "queries": [
      {
        "id": "models",
        "label": "模型",
        "terms": [
          "GPT",
          "Claude",
          "Gemini",
          "Qwen",
          "DeepSeek",
          "Llama",
          "\"open weights\"",
          "\"new model\""
        ]
      },
      {
        "id": "agents",
        "label": "Agent / 图片视频音频 / 开源",
        "terms": [
          "\"AI agent\"",
          "\"coding agent\"",
          "Sora",
          "Veo",
          "Kling",
          "Flux",
          "Midjourney",
          "ElevenLabs",
          "\"text-to-video\"",
          "\"open source\" LLM"
        ]
      },
      {
        "id": "prompts",
        "label": "提示词（每期必有 1–2 条）",
        "terms": [
          "prompt",
          "prompts",
          "提示词"
        ],
        "and": [
          "gpt-image",
          "\"gpt image\"",
          "\"nano banana\"",
          "\"grok imagine\"",
          "midjourney",
          "seedream",
          "flux"
        ],
        "suffix": "has:media -is:retweet -is:reply",
        "min_likes": 30,
        "max_results": 50
      }
    ],
