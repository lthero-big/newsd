# Copy to .env and fill in. Never commit .env.
NEWSD_SECRET_KEY=change-me-to-a-long-random-string
NEWSD_DATABASE_URL=sqlite:///./var/newsd.db
# postgres example: postgresql+psycopg://newsd:newsd@db:5432/newsd
# invite: invite code required | open: public sign-up, invite codes still accepted | closed
# This is the default; an admin can switch it at runtime (newsd admin registration open)
NEWSD_REGISTRATION=invite
NEWSD_COOKIE_SECURE=0       # set 1 behind HTTPS
# Model layer (M2-4). Users set provider/model/key on /settings; these are admin-side knobs.
# NEWSD_LLM_RPM=30                 # requests per minute per user client
# NEWSD_LLM_CONCURRENCY=3          # concurrent requests per user client
# NEWSD_LLM_BASE_OPENAI_COMPATIBLE=https://your-gateway.example.com/v1   # enables the "openai_compatible" provider
# NEWSD_LLM_BASE_OLLAMA=http://ollama:11434
# NEWSD_LLM_ALLOW_PRIVATE_URLS=1   # let non-admin users point a custom Base URL at private/LAN addresses (off by default)
# NEWSD_PROFILES_DIR=/data/profiles   # extra processing profiles (*.md)
# Worker (M2-5): `docker compose up` starts it next to web. It fires the pipeline (collect once, then every user's issue)
# at each listed time in the given zone; the issue key is that day's date in the zone.
# NEWSD_WORKER_TIMES=07:00            # HH:MM[,HH:MM...]
# NEWSD_WORKER_TZ=Asia/Shanghai       # default UTC
# NEWSD_WORKER_RUN_ON_START=0         # 1 = also run one pipeline right after the worker starts
# NEWSD_WORKER_EXTRACT=1              # 0 = skip full-text extraction
# NEWSD_WORKER_SINCE_HOURS=26         # candidate window per issue
# Push (M4): users configure channels on /settings. SMTP is server-side; the Telegram bot token is per user (this is an optional default bot).
# NEWSD_SMTP_HOST=smtp.example.com
# NEWSD_SMTP_PORT=587
# NEWSD_SMTP_USER=
# NEWSD_SMTP_PASSWORD=
# NEWSD_SMTP_FROM=newsd@example.com
# NEWSD_SMTP_SECURITY=starttls        # starttls | ssl | none
# NEWSD_TELEGRAM_BOT_TOKEN=           # default bot for users who did not set their own
# NEWSD_PUBLIC_URL=https://news.example.com   # adds a "full report" link to messages
# NEWSD_PUSH_MAX_ATTEMPTS=4           # retries with backoff: NEWSD_PUSH_BACKOFF=60,300,900 (seconds)
# NEWSD_PUSH_GRACE_HOURS=12           # still deliver this long after the user's push time
# NEWSD_PUSH_ALLOW_PRIVATE=0          # 1 = allow webhooks to private/loopback addresses
# Collection (M2-2). X / selected feeds go through your own RSSHub; unset = those sources are skipped.
# RSSHUB_BASE=https://rsshub.example.com
# RSSHUB_ACCESS_KEY=
# NEWSD_GITHUB_TOKEN=                 # optional, raises the api.github.com rate limit for the GitHub sources
# NEWSD_SESSION_DAYS=30               # login session lifetime
# NEWSD_ENV_FILE=.env                 # which env file to load (default ./.env)
