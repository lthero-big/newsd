# Copy to .env and fill in. Never commit .env.
NEWSD_SECRET_KEY=change-me-to-a-long-random-string
NEWSD_DATABASE_URL=sqlite:///./var/newsd.db
# postgres example: postgresql+psycopg://newsd:newsd@db:5432/newsd
# invite: invite code required | open: public sign-up, invite codes still accepted | closed
# This is the default; an admin can switch it at runtime (newsd admin registration open)
NEWSD_REGISTRATION=invite
NEWSD_COOKIE_SECURE=0       # set 1 behind HTTPS
