# Copy to .env and fill in. Never commit .env.
NEWSD_SECRET_KEY=change-me-to-a-long-random-string
NEWSD_DATABASE_URL=sqlite:///./var/newsd.db
# postgres example: postgresql+psycopg://newsd:newsd@db:5432/newsd
# invite: invite code required | open: public sign-up, invite codes still accepted | closed
# This is the default; an admin can switch it at runtime (newsd admin registration open)
NEWSD_REGISTRATION=invite
NEWSD_COOKIE_SECURE=0       # set 1 behind HTTPS
# Model layer (M2-4). Users set provider/model/key on /settings; these are admin-side knobs.
# NEWSD_LLM_RPM=30                 # requests per minute per user client
# NEWSD_LLM_CONCURRENCY=3          # concurrent requests per user client
# NEWSD_LLM_BASE_OPENAI_COMPATIBLE=https://your-gateway.example.com/v1   # enables the "openai_compatible" provider
# NEWSD_LLM_BASE_OLLAMA=http://ollama:11434
# NEWSD_PROFILES_DIR=/data/profiles   # extra processing profiles (*.md)
